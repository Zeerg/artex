# Docker Deployment configuration (copy as .env)
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# Private GitHub Release updates (only backend reads; token needs Zeerg/artex Contents: read)
ARTEX_UPDATE_GITHUB_TOKEN=

# LLM (Either one or both fill; can also leave empty for UI configuration),
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
